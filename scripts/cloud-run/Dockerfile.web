FROM python:3.12-slim
WORKDIR /app
COPY scripts/cloud-run/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY js /app/js
COPY css /app/css
COPY assets /app/assets
COPY food-pics /app/food-pics
COPY data /app/data
COPY scripts/toki_server.py /app/scripts/toki_server.py
COPY index.html index2.html index3.html index4.html manager.html deploy.html preview-all.html new-bug.html push.html glossary.html /app/
ENV TOKI_API_ONLY=0
ENV TOKI_ENV=testing
ENV TOKI_FORCE_SOURCE=alpha
ENV PYTHONUNBUFFERED=1
CMD ["python3", "scripts/toki_server.py"]
