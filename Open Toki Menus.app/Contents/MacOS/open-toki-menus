#!/bin/bash
# Open Toki Menus — thin launcher. Dialog + server + browsers live in tile_menus.py.

set -euo pipefail

PYTHON_FW="/Library/Frameworks/Python.framework/Versions/3.11/bin/python3"
APP_BUNDLE="$(cd "$(dirname "$0")/../.." && pwd)"
PROJECT="$(cd "${APP_BUNDLE}/.." && pwd)"

if [[ -x "$PYTHON_FW" ]]; then
  PYTHON="$PYTHON_FW"
elif command -v python3 >/dev/null 2>&1; then
  PYTHON="$(command -v python3)"
else
  osascript -e 'display dialog "Python 3 not found.\nInstall Python from python.org." buttons {"OK"} default button 1 with icon stop with title "Toki Menus"'
  exit 1
fi

export TOKI_PROJECT="$PROJECT"
export TOKI_PORT="${TOKI_PORT:-8765}"
export TOKI_PYTHON="$PYTHON"
export TOKI_SERVER_LOG="${TOKI_SERVER_LOG:-/tmp/toki-menu-server.log}"

exec "$PYTHON" "${APP_BUNDLE}/Contents/Resources/tile_menus.py" "$@"
